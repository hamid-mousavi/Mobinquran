# ==========================================
# تنظیمات کلیدهای هوش مصنوعی (AI Providers)
# داشتن حداقل یک کلید برای فعال‌سازی دستیار کافی است
# ==========================================

# کلید گوگل جمینای (پیشنهادی و رایگان از https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# کلید جایگزین گروک (پرسرعت و رایگان از https://console.groq.com)
GROQ_API_KEY=

# کلید جایگزین دیپ‌سیک (از https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# کلید اوپن‌روتر (پشتیبانی از چندین مدل از https://openrouter.ai)
OPENROUTER_API_KEY=

# ==========================================
# تنظیمات و سیاست‌های دستیار تدبّر
# ==========================================

# فعال یا غیرفعال بودن کلی دستیار هوشمند (true / false)
AI_ENABLED=true

# سوئیچ قطع اضطراری دستیار (false)
AI_KILL_SWITCH=false

# اولویت‌بندی ارائه‌دهنده‌ها در چرخهٔ Fallback خودکار
AI_PROVIDER_ORDER=gemini,groq,deepseek,openrouter

# سهمیهٔ تعداد درخواست روزانه برای هر دستگاه/کاربر
AI_DAILY_LIMIT=20

# ==========================================
# ذخیره‌سازی ابری سهمیه (اختیاری - Upstash Redis)
# در صورت خالی بودن، برنامه به طور خودکار از حافظه محلی سرور (In-Memory) استفاده می‌کند
# ==========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

